# PEW Configuration — project-specific settings for phase-execution-workflow
#
# Copy this file to your repo root as `pew.yaml` and customize for your project.
# All paths are relative to the repo root.
# See skills/build/SKILL.md for full config documentation.

project:
  name: 'My Project'
  description: 'Brief project description'

# --- Paths ---
# Override these to match your project's directory structure.
# Defaults: phases/phase-tracker.yaml, phases/implementation-plan.md, phases/, phases/research/
paths:
  tracker: 'phases/phase-tracker.yaml'
  plan: 'phases/implementation-plan.md'
  phases: 'phases'
  research: 'phases/research'
  audit_test: 'phases/audit/test'  # /test-audit output directory
  audit_ux: 'phases/audit/ux'      # /ux-audit output directory
  guidelines: '' # path to development playbooks/guidelines dir (optional)

# --- Tech Stack ---
stack:
  description: '' # e.g., 'React, Tailwind, NestJS, PostgreSQL'
  frontend_src: '' # e.g., 'src/' or 'apps/web/src/'
  component_paths: [] # e.g., ['components/', 'features/*/components/']
  install_commands: {} # e.g., { add_component: 'npx shadcn@latest add', add_package: 'npm install' }

# --- Verification Commands ---
commands:
  verify: '' # e.g., 'npm run lint && npm run typecheck && npm test'
  e2e: '' # e.g., 'npm run test:e2e'

# --- Competitors (for feature-benchmarker research) ---
competitors: []
# - Competitor A
# - Competitor B

# --- Phase Sizing ---
# When adding phases with `pw.sh add-phase --size <size>`, controls which steps run:
#   large  (default) — all 7 steps
#   medium — skips IDEAS (no market research)
#   small  — skips IDEAS + RESEARCH (minimal BRD → PLAN → BUILD → CHECK)

# --- Phase References ---
# Phases can link external docs (UX audits, research, etc.) via the `refs` field.
# Agents read these to resolve finding IDs (F-001, J-001) cited in the brief.
# Add via CLI:  pw.sh add-phase --refs "phases/audit/ux/04-audit.md,phases/audit/ux/01-goals.md"
# Or directly in the tracker YAML under each phase's `refs` list.

# --- Conventions ---
conventions_file: '' # path to a conventions/decisions doc (optional)

# --- Council Review ---
council:
  enabled: true
  max_findings_per_expert: 15
  skip_tags:
    - docs-only
  # experts: []  # customize per domain:
  # - domain: security
  #   reference_doc: 'docs/security-policy.md'
  # - domain: postgres
  #   agent_file: 'my-agents/postgres-reviewer.md'
  #   file_patterns: ['**/*.sql', '**/migrations/**']

# --- Approval Gates ---
# Pause for user approval before BUILD and CLOSE (fires in auto mode too)
approval_gates:
  before_build: true
  before_close: true

# --- Product Review (browser-based FC validation) ---
product_review:
  enabled: true
  app_url: 'http://localhost:5173'
  start_command: '' # e.g., 'make dev-up' or 'npm run dev'
