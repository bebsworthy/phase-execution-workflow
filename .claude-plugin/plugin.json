{
  "name": "pew",
  "description": "Phase Execution Workflow — 7-step delivery loop (IDEAS → BRD → RESEARCH → SPEC → PLAN → BUILD → CHECK/CLOSE) with YAML tracking, quality gates, council review, and sub-agents.",
  "version": "4.0.2",
  "author": {
    "name": "Boyd Stratton"
  },
  "license": "MIT",
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "build-|council-|ux-audit-",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/inject-config.sh"
          }
        ]
      }
    ]
  },
  "keywords": [
    "workflow",
    "phase",
    "delivery",
    "quality-gates",
    "code-review",
    "council",
    "traceability",
    "brd",
    "spec"
  ]
}
