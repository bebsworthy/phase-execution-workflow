#!/usr/bin/env bash
# Git pre-push hook: auto-bump patch version in plugin.json + marketplace.json.
#
# Install:  ln -sf ../../plugin/scripts/pre-push-bump .git/hooks/pre-push
#
# If the version hasn't been bumped in the commits being pushed, this hook
# bumps the patch version, commits it, and aborts the push so you can re-push
# with the version bump included.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# Resolve to repo root — works whether run as hook (.git/hooks/) or directly
REPO_ROOT="$(git rev-parse --show-toplevel)"
PLUGIN_JSON="$REPO_ROOT/plugin/.claude-plugin/plugin.json"
MARKETPLACE="$REPO_ROOT/.claude-plugin/marketplace.json"

if [[ ! -f "$PLUGIN_JSON" ]]; then
  exit 0  # Not a plugin repo, skip
fi

# Read remote and ref info from stdin (standard pre-push hook protocol)
while read -r local_ref local_sha remote_ref remote_sha; do
  # Skip delete pushes
  if [[ "$local_sha" == "0000000000000000000000000000000000000000" ]]; then
    continue
  fi

  # Check if marketplace.json was already modified in the commits being pushed
  if [[ "$remote_sha" == "0000000000000000000000000000000000000000" ]]; then
    # New branch — check all commits
    range="$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  if git diff --name-only "$range" -- "plugin/.claude-plugin/plugin.json" ".claude-plugin/marketplace.json" | grep -q .; then
    # Version was already touched in this push, nothing to do
    exit 0
  fi
done

# Version wasn't bumped — bump it now
"$REPO_ROOT/plugin/scripts/pw.sh" bump-version --bump patch >/dev/null 2>&1
git -C "$REPO_ROOT" add "$PLUGIN_JSON" "$MARKETPLACE"
git -C "$REPO_ROOT" commit -m "chore: bump version (auto)"

echo ""
echo ">>> Version auto-bumped. Please push again to include the bump."
echo ""
exit 1
