#!/usr/bin/env bash
# Git pre-push hook: auto-bump patch version across ALL plugins in sync.
#
# Install:  ln -sf ../../plugin/scripts/pre-push-bump .git/hooks/pre-push
#
# Reads marketplace.json to discover plugins. If any plugin's files changed
# without a version bump, bumps the patch version for ALL plugins to the same
# new version, commits, and aborts the push so you can re-push.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
MARKETPLACE="$REPO_ROOT/.claude-plugin/marketplace.json"

if [[ ! -f "$MARKETPLACE" ]]; then
  exit 0
fi

# Read remote and ref info from stdin (standard pre-push hook protocol)
RANGE=""
REMOTE_SHA=""
while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "$local_sha" == "0000000000000000000000000000000000000000" ]]; then
    continue
  fi
  REMOTE_SHA="$remote_sha"
  if [[ "$remote_sha" == "0000000000000000000000000000000000000000" ]]; then
    RANGE="$local_sha"
  else
    RANGE="$remote_sha..$local_sha"
  fi
done

if [[ -z "$RANGE" ]]; then
  exit 0
fi

# Build plugin list from marketplace.json: "source_dir" per line (stripped of ./)
PLUGIN_DIRS=$(python3 -c "
import json, sys
mp = json.loads(open(sys.argv[1]).read())
for p in mp.get('plugins', []):
    print(p.get('source', '').lstrip('./'))
" "$MARKETPLACE")

# Check if any plugin needs a bump
ANY_NEEDS_BUMP=false
while IFS= read -r plugin_dir; do
  PLUGIN_JSON="$REPO_ROOT/$plugin_dir/.claude-plugin/plugin.json"
  [[ -f "$PLUGIN_JSON" ]] || continue

  CHANGED=$(git diff --name-only "$RANGE" -- "$plugin_dir/" \
    | grep -v "$plugin_dir/.claude-plugin/plugin.json" \
    | head -1 || true)
  [[ -n "$CHANGED" ]] || continue

  local_ver=$(python3 -c "import json,sys; print(json.loads(open(sys.argv[1]).read())['version'])" "$PLUGIN_JSON")
  if [[ "$REMOTE_SHA" == "0000000000000000000000000000000000000000" ]]; then
    remote_ver=""
  else
    remote_ver=$(git show "$REMOTE_SHA:$plugin_dir/.claude-plugin/plugin.json" 2>/dev/null \
      | python3 -c "import json,sys; print(json.loads(sys.stdin.read())['version'])" 2>/dev/null || echo "")
  fi

  if [[ "$local_ver" == "$remote_ver" ]]; then
    ANY_NEEDS_BUMP=true
    break
  fi
done <<< "$PLUGIN_DIRS"

if [[ "$ANY_NEEDS_BUMP" != "true" ]]; then
  exit 0
fi

# Bump all plugins to the same new version
python3 -c "
import json, sys

mp_path = sys.argv[1]
repo_root = sys.argv[2]

mp = json.loads(open(mp_path).read())

# Find the highest version across all plugin.json files
max_parts = [0, 0, 0]
for p in mp.get('plugins', []):
    src = p.get('source', '').lstrip('./')
    pj_path = f'{repo_root}/{src}/.claude-plugin/plugin.json'
    try:
        pj = json.loads(open(pj_path).read())
        parts = [int(x) for x in pj['version'].split('.')]
        if parts > max_parts:
            max_parts = parts
    except (FileNotFoundError, KeyError, ValueError):
        continue

# Bump patch
max_parts[2] += 1
new_ver = '.'.join(str(x) for x in max_parts)

# Update every plugin.json and marketplace entry
for p in mp.get('plugins', []):
    src = p.get('source', '').lstrip('./')
    pj_path = f'{repo_root}/{src}/.claude-plugin/plugin.json'
    try:
        pj = json.loads(open(pj_path).read())
        pj['version'] = new_ver
        open(pj_path, 'w').write(json.dumps(pj, indent=2) + '\n')
    except FileNotFoundError:
        continue
    p['version'] = new_ver

open(mp_path, 'w').write(json.dumps(mp, indent=2) + '\n')
print(f'Bumped all plugins to {new_ver}')
" "$MARKETPLACE" "$REPO_ROOT"

# Stage all modified files
git -C "$REPO_ROOT" add "$MARKETPLACE"
while IFS= read -r plugin_dir; do
  PLUGIN_JSON="$REPO_ROOT/$plugin_dir/.claude-plugin/plugin.json"
  [[ -f "$PLUGIN_JSON" ]] && git -C "$REPO_ROOT" add "$PLUGIN_JSON"
done <<< "$PLUGIN_DIRS"

git -C "$REPO_ROOT" commit -m "chore: bump version (auto)"
echo ""
echo ">>> Version auto-bumped. Please push again to include the bump."
echo ""
exit 1
